@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section">
    <div class="hero-content">
        <span class="hero-badge">Sistema de usuarios</span>
        <h1>Registro de Usuarios</h1>
        <p>
            Bienvenido al sistema de usuarios. Gestiona accesos, crea cuentas y
            administra tu perfil de forma rápida y segura.
        </p>

        <div class="hero-actions">
            <a class="primary-btn" href="/Usuario/Login">Iniciar sesión</a>
            <a class="secondary-btn" href="/Usuario/Registro">Registrarse</a>
        </div>
    </div>

    <div class="hero-visual">
        <div class="mini-card card-one">
            <span>Accesos</span>
            <strong>100%</strong>
        </div>
        <div class="mini-card card-two">
            <span>Usuarios</span>
            <strong>+1.2K</strong>
        </div>
        <div class="orbit-ring"></div>
    </div>
</div>