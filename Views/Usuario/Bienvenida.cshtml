@model TP05.Models.Usuario

<div class="auth-page">
    <div class="welcome-card">
        <h1>Bienvenido @Model.Nombre</h1>

        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Nombre de usuario:</strong> @Model.NombreUsuario</p>
        <p><strong>Nombre:</strong> @Model.Nombre</p>
        <p><strong>Apellido:</strong> @Model.Apellido</p>
        <p><strong>Tipo de usuario:</strong> @Model.TipoUsuario</p>

        <a href="/Usuario/Logout">Cerrar sesión</a>
    </div>
</div>
